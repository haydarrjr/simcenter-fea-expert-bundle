{
  "schema_version": 1,
  "bundle": {
    "id": "simcenter-fea-expert",
    "name": "Simcenter 3D FEA Expert",
    "version": "0.1.2",
    "os": [
      "windows"
    ]
  },
  "artifact_name": "agents-artefact-windows.zip",
  "sidecar_name": ".sim-ai-agents.toml",
  "main_agent_name": "fea-expert-agent",
  "recipe": ".agents/recipes/fea-expert-agent.yaml",
  "subrecipes_dir": ".agents/recipes/subrecipes/",
  "subrecipes": [
    "fea-model-inspector.yaml",
    "fea-journal-author.yaml",
    "fea-solver-diagnostics.yaml",
    "fea-results-post.yaml",
    "fea-verifier.yaml",
    "product-support-agent.yaml"
  ],
  "required_refs": [
    "Simcenter 3D",
    "Designcenter Open",
    "Product Support"
  ],
  "optional_refs": [
    "Simcenter Nastran MCP",
    "Batch Post"
  ],
  "required_platform_extensions": [
    "skills",
    "summon"
  ],
  "readme_dir": "dist/docs/",
  "readme_file": "README.md",
  "overlay_dir": "overlay/skills/",
  "overlay_replaces": [
    "simcenter-parametric-sol101"
  ],
  "skill_exclude_globs": [
    "skills/*/agents/openai.yaml"
  ],
  "expected_total_skills": 38,
  "manifest_contributions": [
    {
      "type": "recipes",
      "source": ".agents/recipes/"
    },
    {
      "type": "skills",
      "source": ".agents/skills/"
    },
    {
      "type": "readme",
      "source": "dist/docs/"
    },
    {
      "type": "mcps",
      "source": "integration/simcenter-3d/mcps/model-inspection",
      "os": [
        "windows"
      ],
      "include": [
        "launch-simcenter3d-mcp.bat"
      ]
    },
    {
      "type": "mcps",
      "source": "integration/simcenter-3d/mcps/batchpost",
      "os": [
        "windows"
      ],
      "include": [
        "launch-batchpost-mcp.bat"
      ]
    },
    {
      "type": "mcps",
      "source": "integration/simcenter-3d/mcps/designcenter-open",
      "os": [
        "windows"
      ],
      "include": [
        "launch-designcenter-mcp.bat"
      ]
    }
  ],
  "allowed_suffixes": [
    ".md",
    ".py",
    ".json",
    ".yaml",
    ".yml",
    ".xsd",
    ".bat"
  ],
  "forbidden_suffixes": [
    ".prt",
    ".step",
    ".stp",
    ".x_t",
    ".jt",
    ".iges",
    ".igs",
    ".pdf",
    ".chm",
    ".exe",
    ".dll",
    ".pyd",
    ".so",
    ".log",
    ".jsonl",
    ".env"
  ],
  "credential_re": "(?i)-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|\\b(?:sk-[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,})\\b|\\bBearer\\s+[A-Za-z0-9._~+/=-]{24,}",
  "local_path_re": "(?i)(?<![A-Z0-9_])[A-Z]:[\\\\/]|\\\\\\\\[A-Za-z0-9._-]+\\\\|(?<![\\w.])/(?:home|Users|tmp|var/tmp|mnt|opt|etc)/|%USERPROFILE%|(?<![\\w~.])~/|file:///",
  "training_id_re": "(?i)\\bcase[-_ ]?138\\b|D:\\\\N\\\\tmp|D:/N/tmp",
  "copyright_re": "(?i)\\b(?:copyright|all rights reserved|proprietary|unpublished work)\\b|\\u00a9",
  "scan_allowlist": [],
  "forbidden_builtin_extensions": [
    "developer"
  ],
  "evidence_classes": [
    "SOURCE_TESTED",
    "DOCUMENTED_2606_CANDIDATE",
    "MCP_2612_DISCOVERED",
    "HOST_QUALIFIED",
    "NATIVE_EXECUTED",
    "SOLVER_VERIFIED",
    "ENGINEERING_ACCEPTED"
  ],
  "forbidden_evidence_tokens": [
    "SANDBOX_TESTED",
    "LIVE_EXECUTED",
    "SOLVER_RECEIPT"
  ],
  "fail_on_copyright_marker": false,
  "integration_root": "integration/simcenter-3d",
  "integration_receipt": "integration/simcenter-3d/source.json",
  "expected_visible_agents": 5,
  "integration_mcp_map": {
    "mcps/model-inspection/launch-simcenter3d-mcp.bat": "mcps/fea-model-inspection/launch-simcenter3d-mcp.bat",
    "mcps/batchpost/launch-batchpost-mcp.bat": "mcps/fea-batchpost/launch-batchpost-mcp.bat",
    "mcps/designcenter-open/launch-designcenter-mcp.bat": "mcps/fea-designcenter-open/launch-designcenter-mcp.bat"
  },
  "manifest_mcp_names": [
    "Simcenter 3D",
    "Batch Post",
    "Designcenter Open"
  ]
}
