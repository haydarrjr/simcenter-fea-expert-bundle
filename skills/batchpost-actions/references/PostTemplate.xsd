    Filename: PostTemplate.xsd

    This is the XML schema definition file for template XML file, which describes
    the keywords used to generate the description for template nodes.

    The schema definition complies with the w3c standard. The XML 
    standard can be found in http://www.w3.org/XML/Schema.

=======================================================================
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Strict Boolean helper to match read_logical_node / read_logical_int_node -->
  <xs:simpleType name="sppBoolean">
    <xs:annotation>
      <xs:documentation>
        Strict Boolean type allowing only '0' or '1'.
        Using 'true' or 'false' will trigger warnings in the NX Post Template parser and unset apply-clean mode.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Color index constraint [0..216] helper -->
  <xs:simpleType name="colorIndex">
    <xs:annotation>
      <xs:documentation>
        Integer color index from the default 216-color table. Range: [0..216].
        Color index 0 is a special value meaning "not set"/"implied".
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="216"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Vector3D helper used for vectors and origins -->
  <xs:complexType name="vector3D">
    <xs:sequence>
      <xs:element name="i" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>X or i component of the 3D coordinate/direction vector.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="j" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Y or j component of the 3D coordinate/direction vector.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="k" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Z or k component of the 3D coordinate/direction vector.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- HeaderLineType representing custom tokens and counts on a custom legend line -->
  <xs:complexType name="headerLineType">
    <xs:annotation>
      <xs:documentation>
        Represents a single customized line of the legend header, made up of multiple tokens.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="TokenCount" type="xs:integer" minOccurs="0">
        <xs:annotation>
          <xs:documentation>The number of active annotation tokens in this line.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Token0" type="xs:string" minOccurs="0"/>
      <xs:element name="Token1" type="xs:string" minOccurs="0"/>
      <xs:element name="Token2" type="xs:string" minOccurs="0"/>
      <xs:element name="Token3" type="xs:string" minOccurs="0"/>
      <xs:element name="Token4" type="xs:string" minOccurs="0"/>
      <xs:element name="Token5" type="xs:string" minOccurs="0"/>
      <xs:element name="Token6" type="xs:string" minOccurs="0"/>
      <xs:element name="Token7" type="xs:string" minOccurs="0"/>
      <xs:element name="Token8" type="xs:string" minOccurs="0"/>
      <xs:element name="Token9" type="xs:string" minOccurs="0"/>
      <xs:element name="UserDefinedCustomText" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>User custom text, used when the token enum is 'User Text'.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="NXPostProcessingTemplate">
    <xs:annotation>
      <xs:documentation>
        Root element for NX/BatchPost Post-Processing XML Templates.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PostView" minOccurs="0">
          <xs:annotation>
            <xs:documentation>
              The postview definition. Currently supports exactly one PostView per template.
            </xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <!-- General Display Options -->
              <xs:element name="Lighted" type="sppBoolean" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>
                    Render with lighting enabled (0/1). Consider disabling this (0) when taking view projections for hardcopy printing/publishing.
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ColorScheme" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>
                    Color distribution scheme of the postview.
                    Allowed: "Contour" (fringe display), "Mid", "Pid" (Physical Property ID), "Mesh".
                    Note: "Contour" replaces the legacy "Fringe" value.
                  </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="Contour"/>
                    <xs:enumeration value="Mid"/>
                    <xs:enumeration value="Pid"/>
                    <xs:enumeration value="Mesh"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Compress" type="sppBoolean" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Toggle display compression (0/1).</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="FaceNormalTolerance" type="xs:double" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Angle tolerance (in degrees) for feature/coplanar elements.</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ValueBandTolerance" type="xs:double" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Tolerance for values within the same contour band.</xs:documentation>
                </xs:annotation>
              </xs:element>

              <xs:element name="ResultDisplayOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Visual and plot display styling settings.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ResultDisplay" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggle result display on/off (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="DisplayStyle" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Defines the plot style.
                          Allowed: "Contour" (Smooth/Banded), "Iso-Line", "Iso-Surface" (corrects legacy typo "so-Surface"),
                          "Cubes", "Spheres", "Arrows", "Tensors", "Streamlines".
                          "Streamlines" requires a streamline seed set defined.
                          Note: "Element" style is obsolete and removed.
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Contour"/>
                          <xs:enumeration value="Iso-Line"/>
                          <xs:enumeration value="Iso-Surface"/>
                          <xs:enumeration value="Cubes"/>
                          <xs:enumeration value="Spheres"/>
                          <xs:enumeration value="Arrows"/>
                          <xs:enumeration value="Tensors"/>
                          <xs:enumeration value="Streamlines"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ColorbarStyle" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Defines color transitions. Allowed: "Smooth", "Banded".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Smooth"/>
                          <xs:enumeration value="Banded"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="BandStyle" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Legacy band style attribute.</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Default"/>
                          <xs:enumeration value="Lines"/>
                          <xs:enumeration value="Value Inline"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="DrawLines" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggles boundary lines between color bands (0/1). Replaces legacy BandStyle.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Lighted" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Re-specifies lighting for the contour face itself (0/1). Consider turning this off for hardcopy printing/publishing.
                        </xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="BeamDisplayStyle" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Controls cross-section styling for 1D beam elements.
                          Allowed: "Line", "Line and Diagram", "Solid".
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Line"/>
                          <xs:enumeration value="Line and Diagram"/>
                          <xs:enumeration value="Solid"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="BeamContourScaleMethod" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Scale method for beam contour. Allowed: "%Model", "Absolute".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="%Model"/>
                          <xs:enumeration value="Absolute"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="BeamContourScaleFactor" type="xs:double" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Scale factor multiplier for beam contour.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ShowBeamContours" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggle beam contour display on/off (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>

                    <xs:element name="CompressOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Refines polygon reduction tolerances.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="DisplayCompression" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle compression (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ValueTolerance" type="xs:double" minOccurs="0"/>
                          <xs:element name="FaceNormalTolerance" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Face normal angle tolerance in degrees (0.0 to 180.0) for compression.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="MarkOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Configures vectors/arrows when DisplayStyle is 'Arrows' or 'Tensors'.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ArrowComponentX" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle X component of arrow display (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ArrowComponentY" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle Y component of arrow display (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ArrowComponentZ" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle Z component of arrow display (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ArrowComponentMag" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle Magnitude component of arrow display (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ArrowComponentResultant" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle Resultant component of arrow display (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ArrowComponentCombinationType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Combination type for arrow component. Allowed: "None", "XY", "YZ", "ZX".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="None"/>
                                <xs:enumeration value="XY"/>
                                <xs:enumeration value="YZ"/>
                                <xs:enumeration value="ZX"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="MarkComponentCombinationType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Allowed: "Normal Component", "Principal Component", "Shear Component", "Force Component", "Moment Component".
                              </xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Normal Component"/>
                                <xs:enumeration value="Principal Component"/>
                                <xs:enumeration value="Shear Component"/>
                                <xs:enumeration value="Force Component"/>
                                <xs:enumeration value="Moment Component"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="Component1" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of component 1 (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Component2" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of component 2 (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Component3" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of component 3 (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Component4" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of component 4 (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Component5" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of component 5 (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="MarkStyle" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Defines the style of the mark. Allowed: "Line", "Solid".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Line"/>
                                <xs:enumeration value="Solid"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="TensorStyle" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Tensor glyph style settings. Allowed: "Detailed", "Arrow", "Box", "Line".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Detailed"/>
                                <xs:enumeration value="Arrow"/>
                                <xs:enumeration value="Box"/>
                                <xs:enumeration value="Line"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="MarkColor" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "Colorbar", "Specified", "TextColor".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Colorbar"/>
                                <xs:enumeration value="Specified"/>
                                <xs:enumeration value="TextColor"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="SpecifiedColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="MarkSize" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>How mark size is controlled. Allowed: "Result" (scaled by value) or "Specified" (constant).</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Result"/>
                                <xs:enumeration value="Specified"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="MaxMarkSize" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Units of the maximum mark size. Allowed: "% Model", "Specified".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="% Model"/>
                                <xs:enumeration value="Specified"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ModelPercentSizeValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Size as percentage of model bounding box.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="SpecifiedMaxMarkSizeValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Absolute maximum mark size.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="HideMarksBelow" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle hiding of marks below a certain threshold (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="BelowOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Criteria for hiding marks. Allowed: "% Maximum Result", "% Absolute Maximum Result", "Result Value".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="% Maximum Result"/>
                                <xs:enumeration value="% Absolute Maximum Result"/>
                                <xs:enumeration value="Result Value"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="BelowResultPercentValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Percentage of maximum result below which marks are hidden.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="BelowSpecifiedResultValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Specific result value below which marks are hidden.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="BelowAbsoluteResultPercentValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Percentage of absolute maximum result below which marks are hidden.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="DisplayNumericValueWithArrow" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of numeric value with arrow (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="DisplayLabelWithArrow" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle display of label with arrow (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="DoubleSidedArrow" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle double-sided arrow display (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="NodalForceReportDisplayOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Visual styling of nodal force vectors.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="DisplayAtCentroid" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle displaying at centroid instead of nodal (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="MassOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Visual styling of lumped mass elements.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="MassSizeOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Lumped mass size option. Allowed: "% Model", "Specified".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="% Model"/>
                                <xs:enumeration value="Specified"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ModelPercentSizeValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Mass size as percentage of model bounding box.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="SpecifiedSizeValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Mass size value in absolute units (mm).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="SpringOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Visual styling of spring elements.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="SpringSizeOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Spring element size option. Allowed: "% Model", "Specified".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="% Model"/>
                                <xs:enumeration value="Specified"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ModelPercentSizeValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Spring size as percentage of model bounding box.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="SpecifiedSizeValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Spring size value in absolute units (mm).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="StreamlineOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Configures streamlines when DisplayStyle is 'Streamlines'.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="StreamlineSeedSet" type="xs:integer" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Seed Set Group Tag ID. You must be told this in a prompt, do not try to guess or modify this without being prompted to do so.
                              </xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="StreamlineVelocityOptions" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Points to the velocity result used to compute the streamlines.</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="LoadCase" type="xs:integer" minOccurs="0"/>
                                <xs:element name="Iteration" type="xs:integer" minOccurs="0"/>
                                <xs:element name="Result" type="xs:string" minOccurs="0"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="StreamlineDataOptions" minOccurs="0">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="ValueSharing" minOccurs="0">
                                  <xs:annotation>
                                    <xs:documentation>Allowed: "Average", "Minimum", "Maximum".</xs:documentation>
                                  </xs:annotation>
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:enumeration value="Average"/>
                                      <xs:enumeration value="Minimum"/>
                                      <xs:enumeration value="Maximum"/>
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="NoDataTreatment" minOccurs="0">
                                  <xs:annotation>
