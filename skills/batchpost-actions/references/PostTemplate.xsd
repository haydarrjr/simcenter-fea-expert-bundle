                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- ResultOptions -->
              <xs:element name="ResultOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Direct parameters linking to the results hierarchy.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="LoadCase" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>0-based index of loadcase.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Iteration" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>0-based index of iteration.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="SubIteration" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>0-based index of sub-iteration, -1 if none.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Result" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Unique result name: [Quantity][Support] or [Quantity][Tag1][Tag2]...[TagN] per result listing.</xs:documentation>
                      </xs:annotation>
                    </xs:element>

                    <xs:element name="AxisymmetricResultOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Parameters for Axisymmetric model expansion.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="RevolveAxis" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Axis of rotation. Allowed: "X-Axis", "Y-Axis", "Z-Axis".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="X-Axis"/>
                                <xs:enumeration value="Y-Axis"/>
                                <xs:enumeration value="Z-Axis"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ResultExtractMethod" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Extraction method. Allowed: "Original 2D Model", "3D Model".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Original 2D Model"/>
                                <xs:enumeration value="3D Model"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="OriginalModelOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Extraction option on original model. Allowed: "At Revolve Angle", "Envelope Across Circumference".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="At Revolve Angle"/>
                                <xs:enumeration value="Envelope Across Circumference"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="EnvelopeOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Enveloping criteria. Only relevant if ResultExtractMethod is '3D Model' and OriginalModelOption is 'Envelope Across Circumference'.
                                Allowed: "Maximum", "Minimum", "Absolute Maximum", "Absolute Minimum", "Average", "Sum".
                              </xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Maximum"/>
                                <xs:enumeration value="Minimum"/>
                                <xs:enumeration value="Absolute Maximum"/>
                                <xs:enumeration value="Absolute Minimum"/>
                                <xs:enumeration value="Average"/>
                                <xs:enumeration value="Sum"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="NumberOfSections" type="xs:integer" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Number of sections to expand the 2D model if extracting 3D expanded results. Higher values give smoother results at the cost of performance.
                              </xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="RevolveAngle" type="xs:double" minOccurs="0"/>
                          <xs:element name="StartRevolveAngle" type="xs:double" minOccurs="0"/>
                          <xs:element name="EndRevolveAngle" type="xs:double" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="CyclicResultOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Parameters for Cyclic symmetry expansion.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ResultExtractionValue" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Cyclic extraction target. Allowed: "Primary", "All", "Selected".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Primary"/>
                                <xs:enumeration value="All"/>
                                <xs:enumeration value="Selected"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="OriginalModelOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Allowed: "Particular Sector", "Enveloped Across Sectors", "At Cyclic Phase Angle", "Enveloped Over Cyclic Phase".
                              </xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Particular Sector"/>
                                <xs:enumeration value="Enveloped Across Sectors"/>
                                <xs:enumeration value="At Cyclic Phase Angle"/>
                                <xs:enumeration value="Enveloped Over Cyclic Phase"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="SectorOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "Index", "Value".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Index"/>
                                <xs:enumeration value="Value"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ValueOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "Maximum", "Minimum", "Absolute Maximum", "Absolute Minimum".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Maximum"/>
                                <xs:enumeration value="Minimum"/>
                                <xs:enumeration value="Absolute Maximum"/>
                                <xs:enumeration value="Absolute Minimum"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="EnvelopeOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Enveloping criteria. Allowed: "Maximum", "Minimum", "Absolute Maximum", "Absolute Minimum", "Average", "Sum".
                              </xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Maximum"/>
                                <xs:enumeration value="Minimum"/>
                                <xs:enumeration value="Absolute Maximum"/>
                                <xs:enumeration value="Absolute Minimum"/>
                                <xs:enumeration value="Average"/>
                                <xs:enumeration value="Sum"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="CyclicPhaseAngle" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Phase angle for cyclic symmetry.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="EnvelopeOverCyclicPhaseMethod" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Enveloping method over cyclic phase. Allowed: "Sweep", "Analytical".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Sweep"/>
                                <xs:enumeration value="Analytical"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="StartCyclicPhaseAngle" type="xs:double" minOccurs="0"/>
                          <xs:element name="EndCyclicPhaseAngle" type="xs:double" minOccurs="0"/>
                          <xs:element name="CyclicPhaseIncrement" type="xs:double" minOccurs="0"/>
                          <xs:element name="SectorIndex" type="xs:integer" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Index of the cyclic sector.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="NumberOfSectorIds" type="xs:integer" minOccurs="0"/>
                          <xs:element name="SectorIds" type="xs:string" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Comma-separated list of sector IDs.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="NumberOfCyclicStages" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Component" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Component name string; see result list (e.g. "Von-Mises", "XX", etc.).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="BeamSection" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Recovery point for beams.
                          Allowed: "Recovery Point C", "Recovery Point D", "Recovery Point E", "Recovery Point F", "Minimum", "Maximum".
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Recovery Point C"/>
                          <xs:enumeration value="Recovery Point D"/>
                          <xs:enumeration value="Recovery Point E"/>
                          <xs:enumeration value="Recovery Point F"/>
                          <xs:enumeration value="Minimum"/>
                          <xs:enumeration value="Maximum"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ShellSection" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Position through thickness for shells.
                          Allowed: "Top", "Bottom", "Minimum", "Maximum", "Average/Middle", "Top and Bottom", "Bending".
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Top"/>
                          <xs:enumeration value="Bottom"/>
                          <xs:enumeration value="Minimum"/>
                          <xs:enumeration value="Maximum"/>
                          <xs:enumeration value="Average/Middle"/>
                          <xs:enumeration value="Top and Bottom"/>
                          <xs:enumeration value="Bending"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="dBScaling" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Enable dB scaling (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="dBReference" type="xs:double" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Reference value for dB scaling. Mapped to 0dB on colorbar, must be positive.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="convertedDBRef" type="xs:double" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Converted dB reference value, used internally in dB math, not displayed.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="dBScale" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Logarithmic base for dB scaling. Allowed: "dB10" (10*log10), "dB20" (20*log10).</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="dB10"/>
                          <xs:enumeration value="dB20"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="SectionNumber" type="xs:integer" minOccurs="0"/>
                    <xs:element name="PlyNumber" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>1-based composite ply index; 0 for non-composite / default.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="LayerNumber" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>1-based layer index for composites; 0 for all/default.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="IncludeMidnodes" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Whether to include mid-nodes for shell results (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ProjectOnNodeNormal" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Whether to project shell results onto node normals (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="PlyID" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Composite ply ID; 0 to ignore.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="PlyLocation" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Location through the ply thickness: 0=Bottom, 1=Middle, 2=Top.</xs:documentation>
                      </xs:annotation>
                    </xs:element>

                    <xs:element name="ComputationOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Averaging and discontinuity mathematical combination controls.</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="NodalCombination" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                How to combine values at nodes.
                                Allowed: "None", "Average", "Sum", "Maximum", "Minimum", "Absolute Minimum", "Absolute Maximum", "Arithmetic Mean", "Discontinuity", "Signed Absolute Minimum", "Signed Absolute Maximum".
                              </xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="None"/>
                                <xs:enumeration value="Average"/>
                                <xs:enumeration value="Sum"/>
                                <xs:enumeration value="Minimum"/>
                                <xs:enumeration value="Maximum"/>
                                <xs:enumeration value="Absolute Minimum"/>
                                <xs:enumeration value="Absolute Maximum"/>
                                <xs:enumeration value="Arithmetic Mean"/>
                                <xs:enumeration value="Discontinuity"/>
                                <xs:enumeration value="Signed Absolute Minimum"/>
                                <xs:enumeration value="Signed Absolute Maximum"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="AccrossPhysicalProperties" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Average across physical property boundaries (0/1). Note spelling 'Accross' with double 'c' is intentional.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="AccrossMaterials" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Average across material boundaries (0/1). Note spelling 'Accross' is intentional.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="AccrossElementTypes" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Average across element type boundaries (0/1). Note spelling 'Accross' is intentional.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="AccrossFeatureAngles" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Average across feature angle boundaries (0/1). Note spelling 'Accross' is intentional.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="FeatureAngleValue" type="xs:double" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Feature angle value in degrees.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="IncludeInternalElements" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle including internal elements in averaging (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="Scope" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Averaging scope. Allowed: "Entire Model", "Visible Model".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Entire Model"/>
                                <xs:enumeration value="Visible Model"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="AcrossNonmanifoldEdges" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Averaging across nonmanifold edges (0/1). Note spelling 'Across' with single 'c' is intentional.</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ExcludeElements" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="DiscontinuityOption" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Discontinuity evaluation option. Allowed: "Relative", "Local", "Weighted", "Balanced".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Relative"/>
                                <xs:enumeration value="Local"/>
                                <xs:enumeration value="Weighted"/>
                                <xs:enumeration value="Balanced"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="CoordinateSystem" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Result transformation coordinate system.
                          Allowed: "Absolute Rectangular", "Absolute Cylindrical", "Absolute Spherical", "Work rectangular", "Work Cylindrical", "Work Spherical", "Native", "Material", "Selected Rectangular", "Selected Cylindrical", "Selected Spherical".
                          Note: The "Selected" variants require a valid ID in CoordinateSystemID. Only set those when explicitly told to.
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Absolute Rectangular"/>
                          <xs:enumeration value="Absolute Cylindrical"/>
                          <xs:enumeration value="Absolute Spherical"/>
                          <xs:enumeration value="Work rectangular"/>
                          <xs:enumeration value="Work Cylindrical"/>
                          <xs:enumeration value="Work Spherical"/>
                          <xs:enumeration value="Native"/>
                          <xs:enumeration value="Material"/>
                          <xs:enumeration value="Selected Rectangular"/>
                          <xs:enumeration value="Selected Cylindrical"/>
                          <xs:enumeration value="Selected Spherical"/>
