                          <xs:element name="FaceColor" type="colorIndex" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- TextOptions -->
              <xs:element name="TextOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Annotations, labels, and numeric formats.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="TextColor" type="colorIndex" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>White is 213 by default.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="FontSizeOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="FontAutoSize" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="FontScale" type="xs:double" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="NumberFormatOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Format" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "Automatic", "Fixed Point", "Scientific".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Automatic"/>
                                <xs:enumeration value="Fixed Point"/>
                                <xs:enumeration value="Scientific"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="DecimalPlaces" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:integer">
                                <xs:minInclusive value="0"/>
                                <xs:maxInclusive value="9"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- LegendBoxDispOptions -->
              <xs:element name="LegendBoxDispOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Legend box styling options.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="DisplayOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="TextAndLeaderColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="TextAlignment" type="xs:integer" minOccurs="0"/>
                          <xs:element name="BoxFillColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="ShowBoxBorder" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="BoxFill" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="BoxTranslucency" type="sppBoolean" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- MinMarkerOptions -->
              <xs:element name="MinMarkerOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Displays minimum peak value marker on the model mesh.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ShowMarker" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="ValueType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "None", "Result And Entity", "Result", "Entity".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None"/>
                          <xs:enumeration value="Result And Entity"/>
                          <xs:enumeration value="Result"/>
                          <xs:enumeration value="Entity"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="DisplayUnit" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="SecondaryData" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="DisplayOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="BoxStyle" type="xs:integer" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>C++ validates BoxStyle strictly to [0..2].</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="TextAndLeaderColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="TextAlignment" type="xs:integer" minOccurs="0"/>
                          <xs:element name="BoxFillColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="ShowBoxBorder" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="BoxFill" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="BoxTranslucency" type="sppBoolean" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- MaxMarkerOptions -->
              <xs:element name="MaxMarkerOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Displays maximum peak value marker on the model mesh.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ShowMarker" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="ValueType" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "None", "Result And Entity", "Result", "Entity".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None"/>
                          <xs:enumeration value="Result And Entity"/>
                          <xs:enumeration value="Result"/>
                          <xs:enumeration value="Entity"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="DisplayUnit" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="SecondaryData" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="DisplayOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="BoxStyle" type="xs:integer" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>C++ validates BoxStyle strictly to [0..2].</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="TextAndLeaderColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="TextAlignment" type="xs:integer" minOccurs="0"/>
                          <xs:element name="BoxFillColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="ShowBoxBorder" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="BoxFill" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="BoxTranslucency" type="sppBoolean" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- AnimationOptions -->
              <xs:element name="AnimationOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Animation player visual settings.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Color" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggle color-spectrum animation (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Deformation" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggle deformation scale animation (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ResultAnimationOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Style" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "Linear", "Modal", "Forward Wave", "Backward Wave".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Linear"/>
                                <xs:enumeration value="Modal"/>
                                <xs:enumeration value="Forward Wave"/>
                                <xs:enumeration value="Backward Wave"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="NumFrames" type="xs:integer" minOccurs="0"/>
                          <xs:element name="SaveFramesInMemory" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="StartPhaseAngle" type="xs:double" minOccurs="0"/>
                          <xs:element name="EndPhaseAngle" type="xs:double" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="IterationAnimationOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="IterationValueType" type="xs:integer" minOccurs="0"/>
                          <xs:element name="StartLoadCase" type="xs:integer" minOccurs="0"/>
                          <xs:element name="StartIteration" type="xs:integer" minOccurs="0"/>
                          <xs:element name="StartSubIteration" type="xs:integer" minOccurs="0"/>
                          <xs:element name="EndLoadCase" type="xs:integer" minOccurs="0"/>
                          <xs:element name="EndIteration" type="xs:integer" minOccurs="0"/>
                          <xs:element name="SubEndIteration" type="xs:integer" minOccurs="0"/>
                          <xs:element name="IterationStep" type="xs:integer" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="StreamlineAnimationOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ShowGuides" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="PulseSynchronization" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "At Seed Point", "Upstream", "Downstream".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="At Seed Point"/>
                                <xs:enumeration value="Upstream"/>
                                <xs:enumeration value="Downstream"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ActiveRegionStartFactor" type="xs:double" minOccurs="0"/>
                          <xs:element name="ActiveRegionEndFactor" type="xs:double" minOccurs="0"/>
                          <xs:element name="NumIncrements" type="xs:integer" minOccurs="0"/>
                          <xs:element name="ContinuousPulse" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="NumTimePeriods" type="xs:integer" minOccurs="0"/>
                          <xs:element name="NumFramesPerPulse" type="xs:double" minOccurs="0"/>
                          <xs:element name="PulseDutyCycle" type="xs:double" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="FullCycle" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="Delay" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Animation delay in milliseconds.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="VectorDisplaySizeControl" type="sppBoolean" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- GroupVisibilities -->
              <xs:element name="GroupVisibilities" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Group visibilities. Item counts and lists must match exactly.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Num0DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Visibilities0DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="Num1DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Visibilities1DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="Num2DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Visibilities2DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="Num3DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Visibilities3DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="NumConnectorGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="VisibilitiesConnectorGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="NumOtherGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="VisibilitiesOtherGroups" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- GroupTranslucency -->
              <xs:element name="GroupTranslucency" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Group translucencies. Note correct spellings 'TranslucencyForXGroups'.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Num0DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="TranslucencyFor0DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="Num1DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="TranslucencyFor1DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="Num2DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="TranslucencyFor2DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="Num3DGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="TranslucencyFor3DGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="NumConnectorGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="TranslucencyForConnectorGroups" type="xs:string" minOccurs="0"/>
                    <xs:element name="NumOtherGroups" type="xs:integer" minOccurs="0"/>
                    <xs:element name="TranslucencyForOtherGroups" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- CsysGroup -->
              <xs:element name="CsysGroup" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="NumCsys" type="xs:integer" minOccurs="0"/>
                    <xs:element name="CsysVisibilities" type="xs:string" minOccurs="0"/>
                    <xs:element name="CsysIds" type="xs:string" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="TemplateType" type="xs:string" use="optional"/>
      <xs:attribute name="Version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
