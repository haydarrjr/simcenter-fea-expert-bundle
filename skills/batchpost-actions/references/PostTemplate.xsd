                        <xs:documentation>Allowed: "None", "Model", "Result".</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="CoordinateSystemID" type="xs:integer" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          ID of the coordinate system if Source is "Model" or "Result". This is not a 0-based index. Do not modify unless explicitly told to.
                        </xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="DisplayBeamResultsInLocalCoordinateSystem" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Always display 1D beam results in local coordinate system (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="DisplayShellResultsInPojectedCoordinateSystem" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Display shell results in projected coordinate system (0/1).
                          Note: the real tag is misspelled 'Pojected' (missing 'r').
                        </xs:documentation>
                      </xs:annotation>
                    </xs:element>

                    <xs:element name="ElementValueOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ElementValue" type="sppBoolean" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Toggle element-value based contouring (0/1).</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element name="ElementCriterion" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>
                                Criterion for element values.
                                Allowed: "Average", "Centroid", "Maximum", "Minimum", "Absolute Maximum", "Absolute Minimum", "Signed Absolute Maximum", "Signed Absolute Minimum".
                              </xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Average"/>
                                <xs:enumeration value="Centroid"/>
                                <xs:enumeration value="Maximum"/>
                                <xs:enumeration value="Minimum"/>
                                <xs:enumeration value="Absolute Maximum"/>
                                <xs:enumeration value="Absolute Minimum"/>
                                <xs:enumeration value="Signed Absolute Maximum"/>
                                <xs:enumeration value="Signed Absolute Minimum"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>

                    <xs:element name="ComplexComponent" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Complex result component selection.
                          Allowed: "Real", "Imaginary", "Amplitude", "Signed Amplitude", "At Phase Angle".
                        </xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Real"/>
                          <xs:enumeration value="Imaginary"/>
                          <xs:enumeration value="Amplitude"/>
                          <xs:enumeration value="Signed Amplitude"/>
                          <xs:enumeration value="At Phase Angle"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ComplexPhaseAngle" type="xs:double" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Phase angle in degrees [0.0, 360.0). Used if ComplexComponent is 'At Phase Angle'.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ComplexStartPhaseAngle" type="xs:double" minOccurs="0"/>
                    <xs:element name="ComplexEndPhaseAngle" type="xs:double" minOccurs="0"/>
                    <xs:element name="ComplexPhaseAngleIncrement" type="xs:double" minOccurs="0"/>
                    <xs:element name="ComplexMaxOverPhaseMethod" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Sweep method. Allowed: "Sweep", "Analytical".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Sweep"/>
                          <xs:enumeration value="Analytical"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="AbsoluteValue" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Take absolute value of result (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ResultScale" type="xs:double" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Result scaling factor multiplier.</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Unit" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Verification result unit name (from the open result's supported list).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="CalculateBeamStressesStrainsFromForces" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggle calculating beam stresses/strains from forces (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="BeamStressesStrainsFillets" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Toggle fillets in beam stress calculation (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="BeamStressesStrainsFilletRadius" type="xs:double" minOccurs="0"/>
                    <xs:element name="AcousticWeighting" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Acoustical weighting criteria. Allowed: "None", "A", "B", "C", "D", "AB", "BC".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None"/>
                          <xs:enumeration value="A"/>
                          <xs:enumeration value="B"/>
                          <xs:enumeration value="C"/>
                          <xs:enumeration value="D"/>
                          <xs:enumeration value="AB"/>
                          <xs:enumeration value="BC"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ReferenceNode" type="xs:integer" minOccurs="0"/>
                    <xs:element name="ReferenceNodeLabel" type="xs:integer" minOccurs="0"/>
                    <xs:element name="AxisymmetricAxisOfRotation" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Axis of rotation for axisymmetric model expansion. Allowed: "X-Axis", "Y-Axis", "Z-Axis".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="X-Axis"/>
                          <xs:enumeration value="Y-Axis"/>
                          <xs:enumeration value="Z-Axis"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- CrossSectionOptions -->
              <xs:element name="CrossSectionOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Result shown on cross-section or cutting views.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="LockRotation" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="LoadCase" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Iteration" type="xs:integer" minOccurs="0"/>
                    <xs:element name="Quantity" type="xs:string" minOccurs="0"/>
                    <xs:element name="Component" type="xs:string" minOccurs="0"/>
                    <xs:element name="ElementValueOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ElementValue" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="ElementCriterion" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Average"/>
                                <xs:enumeration value="Centroid"/>
                                <xs:enumeration value="Minimum"/>
                                <xs:enumeration value="Maximum"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ComplexOption" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Real"/>
                          <xs:enumeration value="Imaginary"/>
                          <xs:enumeration value="Amplitude"/>
                          <xs:enumeration value="Signed Amplitude"/>
                          <xs:enumeration value="At Phase Angle"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ComplexPhaseAngle" type="xs:double" minOccurs="0"/>
                    <xs:element name="AbsoluteValue" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="ResultScale" type="xs:double" minOccurs="0"/>
                    <xs:element name="Unit" type="xs:string" minOccurs="0"/>
                    <xs:element name="Fillets" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="FilletRadius" type="xs:double" minOccurs="0"/>
                    <xs:element name="BeamElement" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="BeamEnd" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Fore"/>
                          <xs:enumeration value="Aft"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- DeformationOptions -->
              <xs:element name="DeformationOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Visual styling of displaced/deformed models.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ShowDeformation" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="SameLoadCaseIterationForColorAndDeformation" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="ShowUndeformedModel" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="DeformShellElementsByNormalComponent" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="ResultOptions" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Result record used for deformations (usually displacement nodal).</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="LoadCase" type="xs:integer" minOccurs="0"/>
                          <xs:element name="Iteration" type="xs:integer" minOccurs="0"/>
                          <xs:element name="SubIteration" type="xs:integer" minOccurs="0"/>
                          <xs:element name="Result" type="xs:string" minOccurs="0"/>
                          <xs:element name="Component" type="xs:string" minOccurs="0"/>
                          <xs:element name="ComplexOption" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Real"/>
                                <xs:enumeration value="Imaginary"/>
                                <xs:enumeration value="Amplitude"/>
                                <xs:enumeration value="Signed Amplitude"/>
                                <xs:enumeration value="At Phase Angle"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="ComplexPhaseAngle" type="xs:double" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ScaleOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="DeformationScaleType" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "% Model", "Absolute".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="% Model"/>
                                <xs:enumeration value="Absolute"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="AbsoluteScaleValue" type="xs:double" minOccurs="0"/>
                          <xs:element name="ModelPercentScaleValue" type="xs:double" minOccurs="0"/>
                          <xs:element name="ReferenceNode" type="xs:integer" minOccurs="0"/>
                          <xs:element name="ReferenceNodeLabel" type="xs:integer" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ReferenceDeformationOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="DeformWith" type="sppBoolean" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- DisplayOnOptions -->
              <xs:element name="DisplayOnOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Where to render graphics (e.g. Free Faces, Volume, Cutting Plane).</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="DisplayOn" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "Free Faces", "Volume", "Cutting Plane".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Free Faces"/>
                          <xs:enumeration value="Volume"/>
                          <xs:enumeration value="Cutting Plane"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ClippingOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="ShowModelOutline" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="ShowClippedModelGhost" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="ClippingValue" type="xs:double" minOccurs="0"/>
                          <xs:element name="ClippingSide" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "Positive", "Negative", "Both".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Positive"/>
                                <xs:enumeration value="Negative"/>
                                <xs:enumeration value="Both"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="CutPlane" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "X", "Y", "Z" (or "R", "T", "P" for cylindrical/spherical).</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:pattern value="[XYZRTP]"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="CutPlaneCoordinateSystem" minOccurs="0">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Absolute Rectangular"/>
                                <xs:enumeration value="Absolute Cylindrical"/>
                                <xs:enumeration value="Absolute Spherical"/>
                                <xs:enumeration value="Work rectangular"/>
                                <xs:enumeration value="Work Cylindrical"/>
                                <xs:enumeration value="Work Spherical"/>
                                <xs:enumeration value="Native"/>
                                <xs:enumeration value="Material"/>
                                <xs:enumeration value="Selected Rectangular"/>
                                <xs:enumeration value="Selected Cylindrical"/>
                                <xs:enumeration value="Selected Spherical"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="CutPlaneCoordinateSystemSource" type="xs:integer" minOccurs="0"/>
                          <xs:element name="CutPlaneCoordinateSystemID" type="xs:integer" minOccurs="0"/>
                          <xs:element name="PostCoordinateSystemOptions" minOccurs="0">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="PostCoordinateSystemType" type="xs:string" minOccurs="0"/>
                                <xs:element name="Orientation" minOccurs="0">
                                  <xs:complexType>
                                    <xs:sequence>
                                      <xs:element name="X_Vector" type="vector3D" minOccurs="0"/>
                                      <xs:element name="Y_Vector" type="vector3D" minOccurs="0"/>
                                      <xs:element name="Z_Vector" type="vector3D" minOccurs="0"/>
                                    </xs:sequence>
                                  </xs:complexType>
                                </xs:element>
                                <xs:element name="Origin" type="vector3D" minOccurs="0"/>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- HeaderOptions -->
              <xs:element name="HeaderOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Title blocks above the legend.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ShowHeader" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "None", "Automatic", "Customized".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None"/>
                          <xs:enumeration value="Automatic"/>
                          <xs:enumeration value="Customized"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="CustomHeaders" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>
                          Contains custom line tokens. Tokens: "Solution", "Loadcase", "Iteration", "Result", "Combination", "Component", "Ply Id And Layer", "Beam Section", "Shell Section", "Cross Section Beam Info", "Formula", "Unit", "Scale", "CSYS", "Deformation", "Complex", "Absolute Value", "Model Summary", "User Text".
                        </xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <!-- Old-style static line options -->
                          <xs:element name="ShowLine1" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line1" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine2" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line2" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine3" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line3" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine4" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line4" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine5" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line5" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine6" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line6" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine7" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line7" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine8" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line8" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine9" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line9" type="xs:string" minOccurs="0"/>
                          <xs:element name="ShowLine10" type="sppBoolean" minOccurs="0"/>
                          <xs:element name="Line10" type="xs:string" minOccurs="0"/>

                          <!-- New-style Legend Header custom token configuration -->
                          <xs:element name="CustomHeaderLineCount" type="xs:integer" minOccurs="0"/>
                          <xs:element name="HeaderLine0" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine1" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine2" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine3" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine4" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine5" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine6" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine7" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine8" type="headerLineType" minOccurs="0"/>
                          <xs:element name="HeaderLine9" type="headerLineType" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- ColorbarOptions -->
              <xs:element name="ColorbarOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Configures colorbar and legend display.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ShowColorbar" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="Spectrum" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "Structural", "Thermal", "Grayscale", "Stoplight".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Structural"/>
                          <xs:enumeration value="Thermal"/>
                          <xs:enumeration value="Grayscale"/>
                          <xs:enumeration value="Stoplight"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="InvertSpectrum" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="SpectrumScale" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "Automatic", "Linear", "Logarithmic".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Automatic"/>
                          <xs:enumeration value="Linear"/>
                          <xs:enumeration value="Logarithmic"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Spacing" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "Equally Spaced", "Round Off", "Level Increment".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Equally Spaced"/>
                          <xs:enumeration value="Round Off"/>
                          <xs:enumeration value="Level Increment"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="AutoLevel" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="NumLevels" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Number of color bar transition levels. Range [1..50].</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:integer">
                          <xs:minInclusive value="1"/>
                          <xs:maxInclusive value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="MinMaxCriterion" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "Result", "Displayed", "Specified", "Combined Viewport Result", "Combined Viewport Displayed".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Result"/>
                          <xs:enumeration value="Displayed"/>
                          <xs:enumeration value="Specified"/>
                          <xs:enumeration value="Combined Viewport Result"/>
                          <xs:enumeration value="Combined Viewport Displayed"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="MinimumValue" type="xs:double" minOccurs="0"/>
                    <xs:element name="MaximumValue" type="xs:double" minOccurs="0"/>
                    <xs:element name="OverflowColor" type="colorIndex" minOccurs="0"/>
                    <xs:element name="UnderflowColor" type="colorIndex" minOccurs="0"/>
                    <xs:element name="Position" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "Left", "Right", "None".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Left"/>
                          <xs:enumeration value="Right"/>
                          <xs:enumeration value="None"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="OverflowDisplayStyle" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "None", "Shaded", "Translucent", "Clipped".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None"/>
                          <xs:enumeration value="Shaded"/>
                          <xs:enumeration value="Translucent"/>
                          <xs:enumeration value="Clipped"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="UnderflowDisplayStyle" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Allowed: "None", "Shaded", "Translucent", "Clipped".</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None"/>
                          <xs:enumeration value="Shaded"/>
                          <xs:enumeration value="Translucent"/>
                          <xs:enumeration value="Clipped"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="OverwriteValue" type="sppBoolean" minOccurs="0"/>
                    <xs:element name="OverwriteColor" type="colorIndex" minOccurs="0"/>
                    <xs:element name="HideColorBarUnits" type="sppBoolean" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Hides the unit displayed at the bottom of the colorbar (0/1).</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="CustomColorbar" type="sppBoolean" minOccurs="0"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <!-- EdgefaceDisplayOptions -->
              <xs:element name="EdgefaceDisplayOptions" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Edge/Face display preferences for deformed (Primary) and undeformed structures.</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="PrimaryOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="EdgeStyle" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "External", "Feature", "Wireframe", "None", "Polygon Edge".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="External"/>
                                <xs:enumeration value="Feature"/>
                                <xs:enumeration value="Wireframe"/>
                                <xs:enumeration value="None"/>
                                <xs:enumeration value="Polygon Edge"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="EdgeColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="FaceStyle" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed face style for primary elements: "Fill", "NoFill".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Fill"/>
                                <xs:enumeration value="NoFill"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="FaceColor" type="colorIndex" minOccurs="0"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="UndeformedOptions" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="EdgeStyle" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed: "External", "Feature", "Wireframe", "None", "Polygon Edge".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="External"/>
                                <xs:enumeration value="Feature"/>
                                <xs:enumeration value="Wireframe"/>
                                <xs:enumeration value="None"/>
                                <xs:enumeration value="Polygon Edge"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="EdgeColor" type="colorIndex" minOccurs="0"/>
                          <xs:element name="FaceStyle" minOccurs="0">
                            <xs:annotation>
                              <xs:documentation>Allowed face style for undeformed elements: "Opaque", "Translucent", "None".</xs:documentation>
                            </xs:annotation>
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="Opaque"/>
                                <xs:enumeration value="Translucent"/>
